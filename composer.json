{
    "name": "duncanmcclean/cookie-notice",
    "description": "Cookie Consent for Statamic - with support for consent groups!",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "DuncanMcClean\\CookieNotice\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DuncanMcClean\\CookieNotice\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Cookie Notice",
            "description": "Cookie Consent for Statamic - with support for consent groups!"
        },
        "laravel": {
            "providers": [
                "DuncanMcClean\\CookieNotice\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.5"
    },
    "require-dev": {
        "laravel/pint": "dev-main",
        "orchestra/testbench": "^10.8 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.1 || ^5.3",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0",
        "spatie/laravel-ray": "^1.43.6",
        "thecodingmachine/safe": "^3.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
